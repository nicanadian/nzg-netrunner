# Optional AI chat. With no model configured, built-in reference help still works.
# Use the Codex CLI's existing ChatGPT subscription login:
# Run `codex login` first, then restart the server.
HELPER_PROVIDER=codex
# HELPER_MODEL=an-available-codex-model

# For separately billed OpenAI API access, use instead:
# HELPER_PROVIDER=openai
# OPENAI_API_KEY=
# HELPER_MODEL=gpt-5-mini

# For a separately installed local model, use instead:
# HELPER_PROVIDER=ollama
# HELPER_MODEL=your-installed-model
# OLLAMA_HOST=http://127.0.0.1:11434
