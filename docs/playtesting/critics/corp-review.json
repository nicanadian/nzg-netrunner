  "strengths": [
    {
      "finding": "The ice rez warning is explicit, actionable, and hard to misread.",
      "evidence": "On approaching Brân in turn4, selecting Let the Runner pass opened WARNING · INACTIVE ICE DOES NOT STOP A RUN, explained no encounter/subroutines, and offered Go back, Rez Brân6, or Do not rez. Returning and rezzing worked."
    },
    {
      "finding": "Legal scoring and costs are easy to identify once the game is underway.",
      "evidence": "Advancing Send a Message to5 promoted Score agenda above normal actions. Scoring, free rez, identity recovery, and Offworld payout resolved without a crash."
    },
    {
      "finding": "Optional asset rez is discoverable without trapping turn completion.",
      "evidence": "Reading installed Regolith showed Rez2 plus text that closing spends nothing and rezzing is optional. Rezzing closed the inspector and exposed Take3 for1click."
    },
    {
      "finding": "The game provided a competitive, coherent match.",
      "evidence": "Corp scored5 points while defending a remote; Runner assembled rig and economy, challenged the scoring server, and won8–5 on turn22. Loss reflects play and card interaction; it is not evidence of a rules defect."
    }
  ],
  "critiques": [
    {
      "priority": "high",
      "category": "choice overload",
      "finding": "Install menus expand every card across every server, including separate identical copies.",
      "reproduction": "Start Corp with multiple ice in hand, open Install. The opening menu showed13 choices, including repeated Tithe→HQ/R&D/Archives/new server entries, each with Read card and Install options.",
      "impact": "The player has to scan many nearly identical rows to make a simple placement decision; this is the strongest remaining source of friction.",
      "recommendation": "Choose a card first, then a destination, or group identical copies with one expandable destination picker."
    },
    {
      "priority": "medium",
      "category": "decision wording",
      "finding": "Continue is still used to decline consequential optional card effects.",
      "reproduction": "Score Send a Message: free-rez selection lists Continue alongside eligible ice. Precision Design recovery and Ansel install windows also use Continue to decline.",
      "impact": "A novice cannot tell whether Continue progresses to another choice or gives up the effect.",
      "recommendation": "Use effect-specific labels such as Decline free rez, Do not recover a card, and Skip optional installation."
    },
    {
      "priority": "medium",
      "category": "pacing and context",
      "finding": "Opponent playback and automatic decision handoffs create pauses and transient instructions that are easy to chase.",
      "reproduction": "After ending Corp actions, the panel sometimes displayed a Tithe subroutine choice briefly before automatic resolution; recorded-action playback then showed a prior step while the live state had progressed. Skip to decision helped.",
      "impact": "The player must distinguish a current decision from an automatically resolving effect and a recorded narration.",
      "recommendation": "Keep automatically resolving text visually distinct from actionable choices; make playback progress and its pending next decision clear."
    },
    {
      "priority": "medium",
      "category": "installation consistency",
      "finding": "Midrun card-effect installation still adds a separate finish-install step even when nothing needs to be trashed and quoted cost is0.",
      "reproduction": "Resolve Ansel1.0 install from HQ, choose Manegarm→Remote1. A modal asks Install Manegarm0 while the run footer also exposes Confirm installation; optional Trash Send a Message appears below.",
      "impact": "The player sees multiple representations of one finish action and has to decide whether optional trash is required.",
      "recommendation": "For a safe0-cost effect install with no required replacement, consider completing directly; otherwise keep one clear primary completion control and a collapsed optional-trash section."
    },
    {
      "priority": "low",
      "category": "rules typography",
      "finding": "Rules text is not consistently converted to the game's readable icon/text style.",
      "reproduction": "Builder full-card preview for Luminal Transubstantiation reads gain click click click; Regolith inspector reads click: Take3credits.",
      "impact": "The UI looks less polished, and new players may mistake the literal word for interaction instructions.",
      "recommendation": "Use a shared card-text formatter across builder, inspector and helper surfaces."
    }
  ],
  "limitations": [
    "Single complete Corporation game, not a statistical or exhaustive rules audit.",
